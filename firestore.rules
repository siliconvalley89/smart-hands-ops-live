rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isAdminAssistant() {
      return isSignedIn() && getUserRole() == 'adminAssistant';
    }

    function isTech() {
      return isSignedIn() && getUserRole() in ['tech', 'seniorConsultant'];
    }

    function isClient() {
      return isSignedIn() && getUserRole() == 'client';
    }

    function isVerifiedTech() {
      return isTech() && request.auth.token.email_verified == true;
    }

    function isVerifiedClient() {
      return isClient() && request.auth.token.email_verified == true;
    }

    function jobHasNoEmbeddedBilling(job) {
      return job.get('billingMigrated', false) == true &&
        !job.keys().hasAny(['serviceFee', 'serviceFeeDescription', 'consumables']);
    }

    function canReadJobConsumables(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return jobHasNoEmbeddedBilling(job) && (
        isAdmin() ||
        (isAdminAssistant() && job.status != 'Completed') ||
        (isVerifiedClient() && job.clientEmail == request.auth.token.email) ||
        (isVerifiedTech() && job.assignedTechEmail == request.auth.token.email)
      );
    }

    function canManageJobConsumables(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return jobHasNoEmbeddedBilling(job) &&
        job.get('invoiceSent', false) != true &&
        (isAdmin() || (isVerifiedTech() && job.assignedTechEmail == request.auth.token.email));
    }

    function breakChangeAllowed() {
      let before = resource.data.get('breaks', []);
      let after = request.resource.data.get('breaks', []);
      let last = before.size() - 1;
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['breaks']) ||
        (after.size() == before.size() + 1 && (
          before.size() == 0 ||
          (before.size() == 1 && before[last].get('endAt', null) != null &&
            request.time >= resource.data.checkInAt + duration.value(12, 'h')))) ||
        (after.size() == before.size() && before.size() > 0 && (
          before[last].get('endAt', null) != null ||
          request.time >= before[last].startAt + duration.value(30, 'm')));
    }

    function canReadJobMedia(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return isAdmin() ||
        (isAdminAssistant() && job.status != 'Completed' && job.get('billingMigrated', false) == true) ||
        (isVerifiedClient() && job.clientEmail == request.auth.token.email) ||
        (isVerifiedTech() && job.assignedTechEmail == request.auth.token.email && job.get('billingMigrated', false) == true);
    }

    function canManageJobMedia(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return isAdmin() ||
        (isVerifiedTech() && job.assignedTechEmail == request.auth.token.email &&
          job.get('billingMigrated', false) == true && job.get('invoiceSent', false) != true);
    }

    match /badges/{badgeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == badgeId && !isClient();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.role in ['tech', 'client']
        )
      );
      // Admins can do full updates; users can update only their own push tokens, mustChangePassword and profile photo fields
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'fcmTokens', 'mustChangePassword', 'profilePhotoUrl', 'profilePhotoData']));
      allow delete: if isAdmin();
    }

    match /technicians/{techId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isTech() &&
        request.auth.uid == techId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email
      );
      allow update: if isAdmin() || (
        isTech() &&
        request.auth.uid == techId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhotoUrl'])
      );
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isAdminAssistant() && resource.data.status != 'Completed' && resource.data.get('billingMigrated', false) == true) ||
        (isVerifiedClient() && resource.data.clientEmail == request.auth.token.email) ||
        (isVerifiedTech() &&
          resource.data.assignedTechEmail == request.auth.token.email &&
          resource.data.get('billingMigrated', false) == true)
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        // Staff and clients create only jobs whose billing is stored separately.
        (isAdminAssistant() &&
          request.resource.data.status in ['Pending', 'Assigned', 'Dispatched'] &&
          jobHasNoEmbeddedBilling(request.resource.data) &&
          request.resource.data.get('createdByRole', '') != 'admin' &&
          request.resource.data.keys().hasOnly([
            'client', 'clientEmail', 'clientPhone', 'location', 'rawLocation', 'lat', 'lng',
            'task', 'details', 'serialNumber', 'scheduledFor', 'scheduledEnd', 'status',
            'assignedTechName', 'assignedTechEmail', 'assignedTechDistanceMiles',
            'assignedTechDistanceKm', 'billingMigrated', 'invoiceSent',
            'clientSignedOff', 'createdAt', 'createdByRole', 'updatedBy'
          ]) &&
          request.resource.data.get('updatedBy', '') == request.auth.token.email &&
          request.resource.data.get('invoiceSent', false) == false) ||
        (isVerifiedClient() &&
          request.resource.data.clientEmail == request.auth.token.email &&
          request.resource.data.status == 'Pending' &&
          request.resource.data.createdByRole == 'client' &&
          jobHasNoEmbeddedBilling(request.resource.data) &&
          request.resource.data.keys().hasOnly([
            'client', 'clientEmail', 'clientPhone', 'location', 'rawLocation', 'lat', 'lng',
            'task', 'details', 'serialNumber', 'scheduledFor', 'scheduledEnd', 'status',
            'billingMigrated', 'invoiceSent',
            'clientSignedOff', 'createdAt', 'createdByRole', 'updatedBy'
          ]) &&
          request.resource.data.get('updatedBy', '') == request.auth.token.email)
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        // Assistants can assign/reassign technicians and set times on open jobs; times only before work starts
        (isAdminAssistant() && resource.data.status != 'Completed' &&
          request.resource.data.status in ['Pending', 'Assigned', 'Dispatched', 'En Route', 'On Site'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'assignedTechName', 'assignedTechEmail', 'assignedTechDistanceMiles',
            'assignedTechDistanceKm', 'status', 'statusUpdatedByRole', 'updatedAt', 'updatedBy',
            'scheduledFor', 'scheduledEnd'
          ]) &&
          request.resource.data.get('updatedBy', '') == request.auth.token.email &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['scheduledFor', 'scheduledEnd']) ||
            resource.data.status in ['Pending', 'Assigned', 'Dispatched'])) ||
        (isVerifiedTech() &&
          resource.data.assignedTechEmail == request.auth.token.email &&
          resource.data.status != 'Completed' &&
          resource.data.get('invoiceSent', false) != true &&
          jobHasNoEmbeddedBilling(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'statusUpdatedByRole', 'enRouteAt', 'updatedAt', 'updatedBy',
            'checkInAt', 'checkInLat', 'checkInLng', 'checkInTechEmail', 'checkInTechName',
            'checkOutAt', 'checkOutLat', 'checkOutLng',
            'breaks', 'signoffRequestedAt'
          ]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkInTechEmail', 'checkInTechName']) ||
            request.resource.data.get('checkInTechEmail', '') == request.auth.token.email) &&
          request.resource.data.get('updatedBy', '') == request.auth.token.email &&
          request.resource.data.status in ['Assigned', 'Dispatched', 'En Route', 'On Site', 'Ready for Signoff'] &&
          breakChangeAllowed()) ||
        // Clients can only sign off their own job once work is ready; admins mark it Completed
        (isVerifiedClient() && resource.data.clientEmail == request.auth.token.email &&
          resource.data.status == 'Ready for Signoff' &&
          request.resource.data.clientSignedOff == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientSignedOff', 'updatedAt', 'updatedBy']) &&
          request.resource.data.get('updatedBy', '') == request.auth.token.email)
      );
      allow delete: if isAdmin();

      match /consumables/{itemId} {
        allow read: if canReadJobConsumables(jobId);
        allow create: if canManageJobConsumables(jobId) &&
          request.resource.data.keys().hasOnly(['description', 'qty', 'createdAt', 'partId']) &&
          request.resource.data.keys().hasAll(['description', 'qty']) &&
          request.resource.data.get('partId', '') is string &&
          (request.resource.data.get('partId', '') == '' ||
            exists(/databases/$(database)/documents/parts/$(request.resource.data.get('partId', '')))) &&
          request.resource.data.description is string &&
          request.resource.data.qty is number &&
          request.resource.data.qty >= 1;
        allow update: if canManageJobConsumables(jobId) &&
          request.resource.data.keys().hasOnly(['description', 'qty', 'createdAt', 'updatedAt', 'partId']) &&
          request.resource.data.keys().hasAll(['description', 'qty']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'qty', 'updatedAt']) &&
          request.resource.data.description is string &&
          request.resource.data.qty is number &&
          request.resource.data.qty >= 1;
        allow delete: if canManageJobConsumables(jobId);
      }

      match /photos/{photoId} {
        allow read: if canReadJobMedia(jobId);
        allow create: if canManageJobMedia(jobId) &&
          request.resource.data.keys().hasOnly(['type', 'url', 'path', 'uploadedAt', 'uploadedBy']) &&
          request.resource.data.keys().hasAll(['type', 'url', 'uploadedAt', 'uploadedBy']) &&
          request.resource.data.type in ['before', 'after'] &&
          request.resource.data.url is string &&
          request.resource.data.get('path', '') is string &&
          request.resource.data.uploadedAt is timestamp &&
          request.resource.data.uploadedBy == request.auth.token.email;
        allow update: if false;
        allow delete: if canManageJobMedia(jobId);
      }

      match /files/{fileId} {
        allow read: if canReadJobMedia(jobId);
        allow create: if canManageJobMedia(jobId) &&
          request.resource.data.keys().hasOnly(['name', 'url', 'path', 'size', 'type', 'uploadedAt', 'uploadedBy']) &&
          request.resource.data.keys().hasAll(['name', 'url', 'size', 'uploadedAt', 'uploadedBy']) &&
          request.resource.data.name is string &&
          request.resource.data.url is string &&
          request.resource.data.get('path', '') is string &&
          request.resource.data.get('type', '') is string &&
          request.resource.data.size is number &&
          request.resource.data.size < 10 * 1024 * 1024 &&
          request.resource.data.uploadedAt is timestamp &&
          request.resource.data.uploadedBy == request.auth.token.email;
        allow update: if false;
        allow delete: if canManageJobMedia(jobId);
      }

      match /payments/{paymentId} {
        allow read: if isAdmin() || (
          isVerifiedClient() &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.clientEmail == request.auth.token.email
        );
        allow create: if isAdmin() &&
          request.resource.data.keys().hasOnly(['amount', 'method', 'reference', 'receivedAt', 'recordedAt', 'recordedBy', 'voided']) &&
          request.resource.data.keys().hasAll(['amount', 'method', 'receivedAt', 'recordedAt', 'recordedBy', 'voided']) &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.method in ['check', 'ach', 'card', 'cash', 'other'] &&
          request.resource.data.recordedBy == request.auth.token.email &&
          request.resource.data.voided == false;
        // Payments are append-only: admins may void a payment with a reason, never edit or delete it
        allow update: if isAdmin() &&
          resource.data.voided == false &&
          request.resource.data.voided == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidReason', 'voidedBy', 'voidedAt']);
        allow delete: if false;
      }
    }

    function isValidPart(part) {
      return part.keys().hasOnly(['name', 'sku', 'onHand', 'reorderPoint', 'createdAt', 'updatedAt']) &&
        part.keys().hasAll(['name', 'onHand', 'reorderPoint']) &&
        part.name is string && part.name.size() > 0 &&
        part.onHand is number && part.onHand >= 0 &&
        part.reorderPoint is number && part.reorderPoint >= 0 &&
        part.get('sku', '') is string;
    }

    match /parts/{partId} {
      allow read: if isAdmin() || isAdminAssistant() || isVerifiedTech();
      allow create: if isAdmin() && isValidPart(request.resource.data);
      allow update: if isAdmin() && isValidPart(request.resource.data);
      allow delete: if isAdmin();
    }

    match /stockEvents/{eventId} {
      allow read, write: if false;
    }

    function isValidQuote(quote) {
      return quote.keys().hasOnly([
        'client', 'clientEmail', 'clientPhone', 'location', 'task', 'details', 'lines',
        'serviceFee', 'serviceFeeDescription', 'status', 'validUntil', 'createdAt', 'createdBy',
        'updatedBy', 'updatedAt', 'sentAt', 'acceptedAt', 'jobId'
      ]) &&
        quote.keys().hasAll(['client', 'clientEmail', 'lines', 'serviceFee', 'status', 'validUntil', 'createdBy', 'updatedBy']) &&
        quote.client is string &&
        quote.clientEmail is string && quote.clientEmail.size() > 0 &&
        quote.lines is list && quote.lines.size() > 0 && quote.lines.size() <= 50 &&
        quote.serviceFee is number && quote.serviceFee >= 0 &&
        quote.get('serviceFeeDescription', '') is string &&
        quote.status in ['Draft', 'Sent', 'Withdrawn'] &&
        quote.validUntil is timestamp;
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin() || isAdminAssistant() || (
        isVerifiedClient() &&
        resource.data.clientEmail == request.auth.token.email &&
        resource.data.status in ['Sent', 'Accepted']
      );
      allow create: if (isAdmin() || isAdminAssistant()) &&
        request.resource.data.status == 'Draft' &&
        request.resource.data.createdBy == request.auth.token.email &&
        request.resource.data.updatedBy == request.auth.token.email &&
        isValidQuote(request.resource.data);
      allow update: if (isAdmin() || isAdminAssistant()) && (
        // Drafts are edited freely, then sent to the client
        (resource.data.status == 'Draft' &&
          request.resource.data.status in ['Draft', 'Sent'] &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.updatedBy == request.auth.token.email &&
          isValidQuote(request.resource.data)) ||
        // A sent quote can only be withdrawn; its terms are fixed once sent
        (resource.data.status == 'Sent' &&
          request.resource.data.status == 'Withdrawn' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedBy', 'updatedAt']) &&
          request.resource.data.updatedBy == request.auth.token.email)
      );
      // Accepted quotes stay on record because they link to a job
      allow delete: if isAdmin() && resource.data.status != 'Accepted';
    }

    match /{path=**}/consumables/{itemId} {
      allow read: if isAdmin();
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isAdmin();
    }

    match /jobBilling/{jobId} {
      allow read: if isAdmin() || (
        isVerifiedClient() &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.clientEmail == request.auth.token.email
      );
      allow create, update, delete: if isAdmin();
    }

    match /invoiceBilling/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rescheduleRequests/{requestId} {
      allow read: if isAdmin() || isAdminAssistant() || (
        isVerifiedClient() && resource.data.clientEmail == request.auth.token.email
      );
      // Clients ask for a new time on their own job before the technician is dispatched
      allow create: if isVerifiedClient() &&
        request.resource.data.keys().hasOnly(['jobId', 'clientEmail', 'note', 'preferredFor', 'status', 'createdAt', 'createdBy']) &&
        request.resource.data.keys().hasAll(['jobId', 'clientEmail', 'note', 'status', 'createdAt', 'createdBy']) &&
        request.resource.data.clientEmail == request.auth.token.email &&
        request.resource.data.createdBy == request.auth.token.email &&
        request.resource.data.status == 'Open' &&
        request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 500 &&
        (!request.resource.data.keys().hasAny(['preferredFor']) || request.resource.data.preferredFor is timestamp) &&
        request.resource.data.createdAt is timestamp &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.clientEmail == request.auth.token.email &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status in ['Pending', 'Assigned', 'Dispatched'];
      // Staff resolve an open request once; the client cannot change it
      allow update: if (isAdmin() || isAdminAssistant()) &&
        resource.data.status == 'Open' &&
        request.resource.data.status in ['Approved', 'Declined'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']) &&
        request.resource.data.resolvedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    match /systemMetadata/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
